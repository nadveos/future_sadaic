--\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-md text-label-md text-on-surface mb-1\" for=\"work-title\"\u003e\n              Título Oficial de la Obra \u003cspan class=\"text-status-error\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cinput class=\"w-full bg-surface-container-lowest text-on-surface px-3.5 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-border-focus transition-all pr-32 shadow-inner\" id=\"work-title\" placeholder=\"Ej. Crimen, Los Dinosaurios, Adiós Nonino\" type=\"text\" value=\"Puente Estelar en Sol Menor\"/\u003e\n\u003cdiv class=\"absolute right-3 top-1/2 -translate-y-1/2 flex items-center gap-1.5 text-status-success bg-surface-container-high px-2 py-1 rounded text-[11px] font-label-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[14px]\"\u003echeck_circle\u003c/span\u003e\n\u003cspan\u003eSin homónimos activos\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"font-label-sm text-label-sm text-text-muted mt-1\"\u003eRegistrar con mayúsculas y minúsculas estándar. Se verificará colisión fonética en el Repertorio Único Argentino.\u003c/p\u003e\n\u003c/div\u003e\n\u003c!-- Subtítulo o versión alternativa --\u003e\n\u003cdiv class=\"grid grid-cols-1 md:grid-cols-2 gap-space-md\"\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-md text-label-md text-on-surface mb-1\" for=\"work-subtitle\"\u003e\n                Subtítulo o Título Alternativo (Opcional)\n              \u003c/label\u003e\n\u003cinput class=\"w-full bg-surface-container-lowest text-on-surface px-3.5 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-border-focus transition-all shadow-inner\" id=\"work-subtitle\" placeholder=\"Ej. Versión Acústica Cuarteto\" type=\"text\"/\u003e\n\u003c/div\u003e\n\u003c!-- Género Musical --\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-md text-label-md text-on-surface mb-1\" for=\"genre-select\"\u003e\n                Género / Ritmo Principal \u003cspan class=\"text-status-error\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cselect class=\"w-full bg-surface-container-lowest text-on-surface px-3.5 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-border-focus transition-all\" id=\"genre-select\"\u003e\n\u003coption selected=\"\" value=\"rock-nacional\"\u003eRock Nacional / Pop Rock\u003c/option\u003e\n\u003coption value=\"tango\"\u003eTango / Milonga / Vals Porteño\u003c/option\u003e\n\u003coption value=\"folclore\"\u003eFolclore / Chacarera / Zamba\u003c/option\u003e\n\u003coption value=\"urbano\"\u003eTrap / Hip-Hop / R&amp;B Contemporáneo\u003c/option\u003e\n\u003coption value=\"sinfonica\"\u003eMúsica Académica / Sinfónica / Cámara\u003c/option\u003e\n\u003coption value=\"electronica\"\u003eElectrónica / Sintetizada / Ambient\u003c/option\u003e\n\u003coption value=\"cumbia\"\u003eCumbia / Cuarteto / Música Tropical\u003c/option\u003e\n\u003c/select\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Tipo de Obra y Metadatos --\u003e\n\u003cdiv class=\"grid grid-cols-1 md:grid-cols-3 gap-space-md\"\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-md text-label-md text-on-surface mb-1\" for=\"work-type\"\u003e\n                Naturaleza de la Composición \u003cspan class=\"text-status-error\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cselect class=\"w-full bg-surface-container-lowest text-on-surface px-3.5 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-border-focus transition-all\" id=\"work-type\"\u003e\n\u003coption selected=\"\" value=\"cancion\"\u003eCanción (Letra y Música)\u003c/option\u003e\n\u003coption value=\"instrumental\"\u003eInstrumental Puro\u003c/option\u003e\n\u003coption value=\"letra-sola\"\u003eLetra Sola (Texto Poético)\u003c/option\u003e\n\u003coption value=\"musica-sola\"\u003eMúsica Sola\u003c/option\u003e\n\u003coption value=\"arreglo-dp\"\u003eArreglo sobre Dominio Público\u003c/option\u003e\n\u003c/select\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-md text-label-md text-on-surface mb-1\" for=\"duration\"\u003e\n                Duración (mm:ss) \u003cspan class=\"text-status-error\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cdiv class=\"relative\"\u003e\n\u003cinput class=\"w-full bg-surface-container-lowest text-on-surface px-3.5 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-border-focus transition-all\" id=\"duration\" placeholder=\"03:30\" type=\"text\" value=\"03:45\"/\u003e\n\u003cspan class=\"material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 text-text-muted text-[18px]\"\u003etimer\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-md text-label-md text-on-surface mb-1\" for=\"creation-date\"\u003e\n                Fecha de Creación \u003cspan class=\"text-status-error\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cinput class=\"w-full bg-surface-container-lowest text-on-surface px-3.5 py-2.5 rounded-lg font-body-md text-body-md focus:outline-none focus:ring-2 focus:ring-border-focus transition-all\" id=\"creation-date\" type=\"date\" value=\"2025-02-10\"/\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Códigos Internacionales --\u003e\n\u003cdiv class=\"p-space-md bg-surface-container-low rounded-lg grid grid-cols-1 md:grid-cols-2 gap-space-md\"\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-sm text-label-sm text-on-surface-variant mb-1\" for=\"iswc-field\"\u003e\n                Código ISWC (si fue emitido por CISAC exterior)\n              \u003c/label\u003e\n\u003cinput class=\"w-full bg-surface-card text-on-surface px-3 py-2 rounded-lg font-body-sm text-body-sm focus:outline-none focus:ring-1 focus:ring-secondary\" id=\"iswc-field\" placeholder=\"T-034.523.891-2\" type=\"text\"/\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003clabel class=\"block font-label-sm text-label-sm text-on-surface-variant mb-1\" for=\"isrc-field\"\u003e\n                Código ISRC Fonograma Matriz (CAPIF)\n              \u003c/label\u003e\n\u003cinput class=\"w-full bg-surface-card text-on-surface px-3 py-2 rounded-lg font-body-sm text-body-sm focus:outline-none focus:ring-1 focus:ring-secondary\" id=\"isrc-field\" placeholder=\"AR-F12-25-00192\" type=\"text\"/\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- B. Tarjeta: Reparto de Derechos y Coautorías --\u003e\n\u003csection class=\"bg-surface-card rounded-xl p-space-lg shadow-sm\"\u003e\n\u003cdiv class=\"flex items-center justify-between pb-space-md mb-space-lg bg-surface-container-low -mx-space-lg -mt-space-lg p-space-lg rounded-t-xl\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-secondary text-[24px]\"\u003egroup\u003c/span\u003e\n\u003cdiv\u003e\n\u003ch2 class=\"font-headline-md text-headline-md text-on-surface\"\u003e2. Reparto de Derechos y Coautorías (Porcentajes)\u003c/h2\u003e\n\u003cp class=\"font-body-sm text-body-sm text-text-secondary\"\u003eEstatuto SADAIC: 50% rama Letra + 50% rama Música = 100% Total de la Creación.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cspan class=\"bg-primary text-accent-cyan font-label-sm text-label-sm px-3 py-1 rounded-full shadow-sm\"\u003e\n            Normativa CISAC Art. 34\n          \u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- Alerta de Regla Matemática SADAIC --\u003e\n\u003cdiv class=\"p-space-md bg-surface-container rounded-lg mb-space-md flex items-start gap-space-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-secondary text-[22px] shrink-0 mt-0.5\"\u003einfo\u003c/span\u003e\n\u003cdiv class=\"text-body-sm font-body-sm text-on-surface\"\u003e\n\u003cspan class=\"font-bold text-on-surface\"\u003eRegla de Distribución Legal Obligatoria:\u003c/span\u003e\n            Para obras con género canción, la mitad de los derechos corresponde a los autores de la letra (50%) y la otra mitad a los compositores de la música (50%). Cada sector debe totalizar su 50% exacto para ser validado.\n          \u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Tabla Interactiva de Autores --\u003e\n\u003cdiv class=\"overflow-x-auto mb-space-md rounded-lg bg-surface-container-lowest shadow-sm\"\u003e\n\u003ctable class=\"w-full text-left font-body-sm text-body-sm\"\u003e\n\u003cthead class=\"bg-surface-container-high text-on-surface font-label-md text-label-md uppercase tracking-wider\"\u003e\n\u003ctr\u003e\n\u003cth class=\"py-3 px-4\"\u003eAutor / Titular Registrado\u003c/th\u003e\n\u003cth class=\"py-3 px-4\"\u003eRol en la Obra\u003c/th\u003e\n\u003cth class=\"py-3 px-3 text-center\"\u003eLetra (Máx 50%)\u003c/th\u003e\n\u003cth class=\"py-3 px-3 text-center\"\u003eMúsica (Máx 50%)\u003c/th\u003e\n\u003cth class=\"py-3 px-3 text-center\"\u003eTotal Obra\u003c/th\u003e\n\u003cth class=\"py-3 px-4 text-right\"\u003eAcción\u003c/th\u003e\n\u003c/tr\u003e\n\u003c/thead\u003e\n\u003ctbody class=\"divide-y divide-border-subtle text-on-surface\"\u003e\n\u003c!-- Autor Principal (Solicitante) --\u003e\n\u003ctr class=\"bg-surface-container-lowest hover:bg-surface-container-low/60 transition-colors\"\u003e\n\u003ctd class=\"py-3.5 px-4\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm\"\u003e\n\u003cdiv class=\"w-8 h-8 rounded-full bg-primary-container text-accent-cyan flex items-center justify-center font-bold text-xs\"\u003e\n                      GC\n                    \u003c/div\u003e\n\u003cdiv\u003e\n\u003cspan class=\"font-label-lg text-label-lg text-on-surface block\"\u003eGustavo Cerati (Legajo AR-48.291-A)\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-secondary flex items-center gap-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[14px]\"\u003ebadge\u003c/span\u003e\n                        Socio Activo SADAIC · CUIT 20-14289381-4\n                      \u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/td\u003e\n\u003ctd class=\"py-3.5 px-4\"\u003e\n\u003cspan class=\"inline-block bg-surface-container-high text-on-surface px-2.5 py-1 rounded text-label-sm font-label-sm\"\u003e\n                    Autor (Letra) y Compositor (Música)\n                  \u003c/span\u003e\n\u003c/td\u003e\n\u003ctd class=\"py-3.5 px-3 text-center\"\u003e\n\u003cspan class=\"font-label-md text-label-md text-on-surface font-bold\"\u003e50.00%\u003c/span\u003e\n\u003c/td\u003e\n\u003ctd class=\"py-3.5 px-3 text-center\"\u003e\n\u003cspan class=\"font-label-md text-label-md text-on-surface font-bold\"\u003e50.00%\u003c/span\u003e\n\u003c/td\u003e\n\u003ctd class=\"py-3.5 px-3 text-center\"\u003e\n\u003cspan class=\"font-label-lg text-label-lg text-secondary font-bold\"\u003e100.00%\u003c/span\u003e\n\u003c/td\u003e\n\u003ctd class=\"py-3.5 px-4 text-right\"\u003e\n\u003cspan class=\"text-text-muted text-label-sm font-label-sm italic\"\u003eTitular Solicitante\u003c/span\u003e\n\u003c/td\u003e\n\u003c/tr\u003e\n\u003c/tbody\u003e\n\u003c/table\u003e\n\u003c/div\u003e\n\u003c!-- Selector / Modal Inline para añadir coautor --\u003e\n\u003cdiv class=\"p-space-md bg-surface-container-low rounded-lg mb-space-md flex flex-wrap items-center justify-between gap-space-md\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-secondary text-[24px]\"\u003eperson_add\u003c/span\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-label-lg text-label-lg text-on-surface\"\u003e¿Esta obra cuenta con coautores o editor musical?\u003c/h4\u003e\n\u003cp class=\"font-label-sm text-label-sm text-text-secondary\"\u003eIncorpore otros socios SADAIC, letristas invitados o editoriales cesionarias.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cbutton class=\"inline-flex items-center gap-2 bg-surface-card hover:bg-surface-container text-on-surface px-4 py-2 rounded-lg font-label-md text-label-md transition-all shadow-sm\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px] text-secondary\"\u003eadd_circle\u003c/span\u003e\n\u003cspan\u003eAgregar Coautor o Editor\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c!-- Indicador Visual de Balance Porcentual --\u003e\n\u003cdiv class=\"p-space-md bg-primary-container text-on-primary rounded-xl\"\u003e\n\u003cdiv class=\"flex flex-wrap items-center justify-between mb-2\"\u003e\n\u003cdiv class=\"flex items-center gap-2\"\u003e\n\u003cspan class=\"material-symbols-outlined text-status-success text-[20px]\"\u003etask_alt\u003c/span\u003e\n\u003cspan class=\"font-label-lg text-label-lg text-on-primary\"\u003eBalance de Titularidad: 100% Asignado\u003c/span\u003e\n\u003c/div\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-accent-cyan font-bold tracking-wider uppercase\"\u003e\n              Planilla Válida para Homologación\n            \u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- Barra doble: Letra + Música --\u003e\n\u003cdiv class=\"w-full bg-on-primary-container/30 h-3 rounded-full overflow-hidden flex\"\u003e\n\u003cdiv class=\"bg-secondary h-full transition-all\" style=\"width: 50%;\" title=\"Letra: 50%\"\u003e\u003c/div\u003e\n\u003cdiv class=\"bg-accent-cyan h-full transition-all\" style=\"width: 50%;\" title=\"Música: 50%\"\u003e\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex justify-between items-center mt-2 text-label-sm font-label-sm text-on-primary-container\"\u003e\n\u003cspan class=\"flex items-center gap-1.5\"\u003e\u003cspan class=\"w-2.5 h-2.5 rounded-full bg-secondary\"\u003e\u003c/span\u003e Letra Asignada: 50% / 50%\u003c/span\u003e\n\u003cspan class=\"flex items-center gap-1.5\"\u003e\u003cspan class=\"w-2.5 h-2.5 rounded-full bg-accent-cyan\"\u003e\u003c/span\u003e Música Asignada: 50% / 50%\u003c/span\u003e\n\u003cspan class=\"font-bold text-on-primary\"\u003eTotal: 100.00%\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- C. Tarjeta: Carga de Partituras, Letra y Maqueta Sonora --\u003e\n\u003csection class=\"bg-surface-card rounded-xl p-space-lg shadow-sm\"\u003e\n\u003cdiv class=\"flex items-center justify-between pb-space-md mb-space-lg bg-surface-container-low -mx-space-lg -mt-space-lg p-space-lg rounded-t-xl\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-secondary text-[24px]\"\u003efolder_zip\u003c/span\u003e\n\u003cdiv\u003e\n\u003ch2 class=\"font-headline-md text-headline-md text-on-surface\"\u003e3. Carga de Partituras, Letra y Maqueta Sonora\u003c/h2\u003e\n\u003cp class=\"font-body-sm text-body-sm text-text-secondary\"\u003eDepósito técnico para archivo pericial y análisis por algoritmos de monitoreo de radiodifusión.\u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cspan class=\"bg-surface-card text-on-surface-variant font-label-sm text-label-sm px-2.5 py-1 rounded-full shadow-sm\"\u003e\n            Formatos Aceptados: PDF, MP3, WAV\n          \u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"space-y-space-lg\"\u003e\n\u003c!-- 1. Partitura / Melodía Escrita (PDF) --\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"flex items-center justify-between mb-2\"\u003e\n\u003clabel class=\"font-label-md text-label-md text-on-surface flex items-center gap-1.5\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px] text-secondary\"\u003equeue_music\u003c/span\u003e\n                Partitura Musical / Guión Melódico en PDF \u003cspan class=\"text-status-error\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-text-muted\"\u003eRequisito DNDA obligatorio\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- Archivo Adjunto (Estado cargado) --\u003e\n\u003cdiv class=\"p-space-md bg-surface-container-low rounded-lg flex items-center justify-between\"\u003e\n\u003cdiv class=\"flex items-center gap-space-md\"\u003e\n\u003cdiv class=\"w-12 h-12 rounded-lg bg-primary-container text-accent-cyan flex items-center justify-center shrink-0\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[28px]\"\u003epicture_as_pdf\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003cspan class=\"font-label-lg text-label-lg text-on-surface block\"\u003epartitura_melodia_armonia_sol_menor.pdf\u003c/span\u003e\n\u003cdiv class=\"flex items-center gap-space-sm text-label-sm font-label-sm text-text-secondary\"\u003e\n\u003cspan\u003e1.84 MB\u003c/span\u003e\n\u003cspan\u003e·\u003c/span\u003e\n\u003cspan class=\"text-status-success font-medium flex items-center gap-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[14px]\"\u003echeck_circle\u003c/span\u003e\n                      Certificado con Hash SHA-256\n                    \u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex items-center gap-2\"\u003e\n\u003cbutton class=\"p-2 text-on-surface-variant hover:text-secondary rounded hover:bg-surface-container transition-colors\" title=\"Previsualizar\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[20px]\"\u003evisibility\u003c/span\u003e\n\u003c/button\u003e\n\u003cbutton class=\"p-2 text-on-surface-variant hover:text-status-error rounded hover:bg-surface-container transition-colors\" title=\"Eliminar y reemplazar\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[20px]\"\u003edelete\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- 2. Letra Completa de la Obra --\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"flex items-center justify-between mb-2\"\u003e\n\u003clabel class=\"font-label-md text-label-md text-on-surface flex items-center gap-1.5\" for=\"lyrics-editor\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px] text-secondary\"\u003earticle\u003c/span\u003e\n                Letra Completa de la Canción \u003cspan class=\"text-status-error\"\u003e*\u003c/span\u003e\n\u003c/label\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-secondary cursor-pointer hover:underline\"\u003eImportar desde archivo .txt / .docx\u003c/span\u003e\n\u003c/div\u003e\n\u003ctextarea class=\"w-full bg-surface-container-lowest text-on-surface p-space-md rounded-lg font-body-sm text-body-sm focus:outline-none focus:ring-2 focus:ring-border-focus transition-all leading-relaxed shadow-inner\" id=\"lyrics-editor\" placeholder=\"Escriba o pegue la letra exacta con estrofas y estribillos...\" rows=\"6\"\u003e(Estrofa 1)\nCae la noche sobre el puente de cristal,\nlas luces titilan con pulso ancestral.\nUn eco lejano me invita a cruzar,\nbuscando la clave que empieza a sonar.\n\n(Estribillo)\nPuente estelar, llévame al mar,\ndonde el acorde no puede callar.\nSombra y reflejo en sol menor,\ngira la rueda de nuestro dolor.\u003c/textarea\u003e\n\u003cp class=\"font-label-sm text-label-sm text-text-muted mt-1\"\u003eEste texto será cotejado ante el Fondo Nacional de las Artes y el Registro Nacional de la Propiedad Intelectual.\u003c/p\u003e\n\u003c/div\u003e\n\u003c!-- 3. Audio / Maqueta de Referencia (Fingerprint acústico) --\u003e\n\u003cdiv\u003e\n\u003cdiv class=\"flex items-center justify-between mb-2\"\u003e\n\u003clabel class=\"font-label-md text-label-md text-on-surface flex items-center gap-1.5\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px] text-secondary\"\u003egraphic_eq\u003c/span\u003e\n                Audio / Maqueta de Referencia (Monitoreo de Radiodifusión)\n              \u003c/label\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-status-warning bg-surface-container px-2 py-0.5 rounded font-medium\"\u003eRecomendado para detección digital\u003c/span\u003e\n\u003c/div\u003e\n\u003c!-- Drag & Drop Zone --\u003e\n\u003cdiv class=\"bg-surface-container-lowest rounded-xl p-space-lg text-center hover:bg-surface-container-low transition-all cursor-pointer shadow-sm group\"\u003e\n\u003cdiv class=\"w-14 h-14 mx-auto rounded-full bg-surface-container-high text-secondary flex items-center justify-center mb-3 group-hover:scale-105 transition-transform\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[30px]\"\u003ecloud_upload\u003c/span\u003e\n\u003c/div\u003e\n\u003ch5 class=\"font-label-lg text-label-lg text-on-surface mb-1\"\u003eHaga clic o arrastre el archivo de audio aquí\u003c/h5\u003e\n\u003cp class=\"font-body-sm text-body-sm text-text-secondary max-w-md mx-auto mb-3\"\u003e\n                Archivos en formato MP3 (mínimo 192 kbps) o WAV estéreo. Máximo 50 MB por obra.\n              \u003c/p\u003e\n\u003cdiv class=\"inline-flex items-center gap-2 bg-primary text-on-primary px-4 py-2 rounded-lg font-label-md text-label-md shadow-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px] text-accent-cyan\"\u003eupload_file\u003c/span\u003e\n\u003cspan\u003eExplorar Archivos Locales\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- D. Tarjeta: Declaración Jurada y Condiciones Legales --\u003e\n\u003csection class=\"bg-surface-card rounded-xl p-space-lg shadow-sm\"\u003e\n\u003cdiv class=\"flex items-start gap-space-md\"\u003e\n\u003cdiv class=\"mt-1\"\u003e\n\u003cinput checked=\"\" class=\"w-5 h-5 accent-secondary rounded cursor-pointer\" id=\"sw-legal\" type=\"checkbox\"/\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003clabel class=\"font-label-lg text-label-lg text-on-surface cursor-pointer select-none\" for=\"sw-legal\"\u003e\n              Declaración Jurada de Originalidad y Autenticidad (Ley 11.723)\n            \u003c/label\u003e\n\u003cp class=\"font-body-sm text-body-sm text-text-secondary mt-1\"\u003e\n              Declaro bajo juramento de ley que la composición aquí descripta es una obra inédita y original de mi autoría / coautoría, deslindando expresamente a SADAIC de cualquier reclamo judicial o extrajudicial por plagio o infracción de marcas y derechos de terceros. Autorizo la verificación en las bases mundiales de CISAC y BMAT.\n            \u003c/p\u003e\n\u003cdiv class=\"mt-space-sm flex items-center gap-space-md text-label-sm font-label-sm text-secondary\"\u003e\n\u003cspan class=\"flex items-center gap-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\"\u003egavel\u003c/span\u003e\n                Términos y Condiciones Legales\n              \u003c/span\u003e\n\u003cspan class=\"flex items-center gap-1\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[16px]\"\u003elock\u003c/span\u003e\n                Token Criptográfico DNDA\n              \u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/section\u003e\n\u003c!-- 4. Barra Fija / Flotante Inferior de Acciones --\u003e\n\u003cdiv class=\"bg-surface-card rounded-xl p-space-md shadow-lg sticky bottom-6 z-30\"\u003e\n\u003cdiv class=\"flex flex-wrap items-center justify-between gap-space-md\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm\"\u003e\n\u003cbutton class=\"inline-flex items-center gap-2 bg-surface-container-low hover:bg-surface-container text-on-surface px-4 py-2.5 rounded-lg font-label-md text-label-md transition-colors shadow-sm\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003esave\u003c/span\u003e\n\u003cspan\u003eGuardar Borrador\u003c/span\u003e\n\u003c/button\u003e\n\u003cbutton class=\"inline-flex items-center gap-2 bg-surface-container-low hover:bg-surface-container text-on-surface px-4 py-2.5 rounded-lg font-label-md text-label-md transition-colors shadow-sm\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003eprint\u003c/span\u003e\n\u003cspan\u003eDescargar Previsualización (PDF)\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex items-center gap-space-sm\"\u003e\n\u003cbutton class=\"inline-flex items-center gap-2 bg-primary hover:bg-primary-container text-on-primary px-6 py-3 rounded-lg font-label-lg text-label-lg transition-all shadow-md group\" type=\"button\"\u003e\n\u003cspan class=\"material-symbols-outlined text-accent-cyan text-[20px] group-hover:rotate-12 transition-transform\"\u003elock\u003c/span\u003e\n\u003cspan\u003eContinuar a Firma Digital y Envío al DNDA\u003c/span\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px]\"\u003earrow_forward\u003c/span\u003e\n\u003c/button\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Columna Lateral: Asistencia Técnica, FAQ & Soporte --\u003e\n\u003caside class=\"lg:col-span-4 space-y-space-lg\"\u003e\n\u003c!-- Tarjeta Resumen del Trámite --\u003e\n\u003cdiv class=\"bg-surface-card rounded-xl p-space-lg shadow-sm\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm mb-space-md\"\u003e\n\u003cdiv class=\"w-10 h-10 rounded-lg bg-surface-container-high text-secondary flex items-center justify-center\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[22px]\"\u003eassignment\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv\u003e\n\u003ch3 class=\"font-headline-sm text-headline-sm text-on-surface\"\u003eResumen de Expediente\u003c/h3\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-text-muted\"\u003eID Trámite: SAD-2025-09821\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"space-y-space-sm font-body-sm text-body-sm text-text-secondary pb-space-md\"\u003e\n\u003cdiv class=\"flex justify-between items-center py-1\"\u003e\n\u003cspan\u003eSocio Solicitante:\u003c/span\u003e\n\u003cspan class=\"font-label-md text-label-md text-on-surface\"\u003eGustavo Cerati\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex justify-between items-center py-1\"\u003e\n\u003cspan\u003eN° de Legajo:\u003c/span\u003e\n\u003cspan class=\"font-label-md text-label-md text-on-surface\"\u003eAR-48.291-A\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex justify-between items-center py-1\"\u003e\n\u003cspan\u003eArancel de Registro:\u003c/span\u003e\n\u003cspan class=\"font-label-md text-label-md text-status-success font-bold\"\u003e100% Bonificado (Socio)\u003c/span\u003e\n\u003c/div\u003e\n\u003cdiv class=\"flex justify-between items-center py-1\"\u003e\n\u003cspan\u003ePlazo de Homologación:\u003c/span\u003e\n\u003cspan class=\"font-label-md text-label-md text-on-surface\"\u003e48 a 72 hs hábiles\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cdiv class=\"bg-surface-container-low p-space-sm rounded-lg flex items-center gap-space-sm mt-space-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-secondary text-[20px]\"\u003esecurity\u003c/span\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-on-surface-variant\"\u003eProtegido por sellado de tiempo de la Infraestructura de Firma Digital de la República Argentina (ONTI).\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- FAQ Rápida para Compositores --\u003e\n\u003cdiv class=\"bg-surface-card rounded-xl p-space-lg shadow-sm\"\u003e\n\u003ch3 class=\"font-headline-sm text-headline-sm text-on-surface mb-space-md flex items-center gap-space-xs\"\u003e\n\u003cspan class=\"material-symbols-outlined text-secondary text-[22px]\"\u003equiz\u003c/span\u003e\n          Preguntas Frecuentes\n        \u003c/h3\u003e\n\u003cdiv class=\"space-y-space-md\"\u003e\n\u003c!-- FAQ 1 --\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-label-md text-label-md text-on-surface mb-1\"\u003e¿Cómo se calculan los porcentajes de coautoría?\u003c/h4\u003e\n\u003cp class=\"font-body-sm text-body-sm text-text-secondary leading-snug\"\u003e\n              La obra se divide en dos mitades autónomas: 50% para la Letra y 50% para la Música. Si usted compuso ambas áreas en solitario, le corresponde el 100% de la obra (50% + 50%).\n            \u003c/p\u003e\n\u003c/div\u003e\n\u003c!-- FAQ 2 --\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-label-md text-label-md text-on-surface mb-1\"\u003e¿Qué sucede si un coautor no está en SADAIC?\u003c/h4\u003e\n\u003cp class=\"font-body-sm text-body-sm text-text-secondary leading-snug\"\u003e\n              Puede ingresarlo mediante su sociedad internacional hermana (BMI, ASCAP, SGAE, AGADU) con su IPI number, o como autor no asociado con su CUIT para reserva de fondos en cuenta especial.\n            \u003c/p\u003e\n\u003c/div\u003e\n\u003c!-- FAQ 3 --\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-label-md text-label-md text-on-surface mb-1\"\u003e¿Es obligatoria la partitura escrita?\u003c/h4\u003e\n\u003cp class=\"font-body-sm text-body-sm text-text-secondary leading-snug\"\u003e\n              Sí. Conforme al Decreto Reglamentario 41.233/34 de la Ley 11.723, el depósito de partitura o guión melódico cifrado es requisito inexcusable para la emisión del título de propiedad intelectual.\n            \u003c/p\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003c!-- Mesa de Ayuda y Contacto SADAIC --\u003e\n\u003cdiv class=\"bg-primary-container text-on-primary rounded-xl p-space-lg shadow-md\"\u003e\n\u003cdiv class=\"flex items-center gap-space-sm mb-space-sm\"\u003e\n\u003cspan class=\"material-symbols-outlined text-accent-cyan text-[28px]\"\u003esupport_agent\u003c/span\u003e\n\u003cdiv\u003e\n\u003ch4 class=\"font-headline-sm text-headline-sm text-on-primary\"\u003eMesa de Ayuda a Socios\u003c/h4\u003e\n\u003cspan class=\"font-label-sm text-label-sm text-on-primary-container\"\u003eDepartamento de Registro de Repertorio\u003c/span\u003e\n\u003c/div\u003e\n\u003c/div\u003e\n\u003cp class=\"font-body-sm text-body-sm text-on-primary-container mb-space-md leading-relaxed\"\u003e\n          Si tiene dudas respecto al encuadre legal de arreglos, seudónimos artísticos o herencias sucesorias, nuestro equipo pericial se encuentra disponible.\n        \u003c/p\u003e\n\u003cdiv class=\"space-y-space-sm\"\u003e\n\u003ca class=\"flex items-center justify-between p-2.5 bg-surface-card/10 hover:bg-surface-card/15 rounded-lg transition-colors text-on-primary text-label-md font-label-md\" href=\"tel:08003337232\"\u003e\n\u003cspan class=\"flex items-center gap-2\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px] text-accent-cyan\"\u003ecall\u003c/span\u003e\n\u003cspan\u003eLínea Gratuita Nacional\u003c/span\u003e\n\u003c/span\u003e\n\u003cspan class=\"text-accent-cyan font-bold\"\u003e0800-333-SADAIC\u003c/span\u003e\n\u003c/a\u003e\n\u003ca class=\"flex items-center justify-between p-2.5 bg-surface-card/10 hover:bg-surface-card/15 rounded-lg transition-colors text-on-primary text-label-md font-label-md\" href=\"https://wa.me/5491140000000\" target=\"_blank\"\u003e\n\u003cspan class=\"flex items-center gap-2\"\u003e\n\u003cspan class=\"material-symbols-outlined text-[18px] text-status-success\"\u003echat\u003c/span\u003e\n\u003cspan\u003eWhatsApp de Guardia Legal\u003c/span\u003e\n\u003c/span\u003e\n\u003cspan class=\"text-on-primary font-bold\"\u003e+54 9 11 5821-9900\u003c/span\u003e\n\u003c/a\u003e\n\u003c/div\u003e\n\u003cdiv class=\"mt-space-md text-[11px] text-on-primary-container text-center font-label-sm\"\u003e\n          Atención de Lunes a Viernes de 9:00 a 18:00 hs (Horario de Buenos Aires).\n        \u003c/div\u003e\n\u003c/div\u003e\n\u003c/aside\u003e\n\u003c/div\u003e\n\u003c/div\u003e\u003c/main\u003e\u003c/div\u003e\u003c/body\u003e\u003c/html\u003e"}